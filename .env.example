# Copy to `.env` and fill in your Supabase project values.
# NEVER commit the real .env file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: a human-friendly name for this PC (falls back to hostname).
PIXL_PC_NAME=

# Set to 1 on the admin's own machine so it never auto-shuts-down on idle.
PIXL_ADMIN_MACHINE=0
